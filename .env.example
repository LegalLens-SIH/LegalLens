MONGODB_URI=mongodb://127.0.0.1:27017/LegalLense
OFFICIAL_PROVISION_KEY=change-this-server-only-key
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=YOUR_VERIFIED_BREVO_SENDER_EMAIL
BREVO_SENDER_NAME=LegalLense
# Comma-separated browser origins for deployment. Leave blank for local
# localhost/127.0.0.1 development only.
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Absolute path to the unchanged consolidated 75-rule source JSON. Leave blank
# to search workspace ancestors; container deployments should mount the source
# file and set this to its mounted path.
LEGAL_METROLOGY_RULESET_PATH=

# YOLO26 object-localization step that runs before PaddleOCR (see backend/ocr/yolo_service.py).
# Set to false to disable YOLO entirely and OCR the full image as before.
YOLO_ENABLED=true
# Pretrained checkpoint name (auto-downloaded by ultralytics) or a path to a
# custom-trained checkpoint, e.g. models/legal_lense_yolo26.pt
YOLO_MODEL_PATH=yolo26n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25
# Leave blank to auto-detect (uses CUDA if available, else CPU). Set to
# "cpu" or "cuda:0" to force a specific device.
YOLO_DEVICE=

# Gemini Flash AI/vision FALLBACK for ambiguous/low-confidence Legal
# Metrology field extraction (see backend/ocr/gemini_service.py). Disabled
# by default - Gemini is only called for the specific fields a scan's own
# PaddleOCR-based extraction could not confidently resolve, never for every
# image, and it never makes the final PASS/FAIL compliance decision (the
# same deterministic backend/services/compliance_engine.py always does).
GEMINI_ENABLED=false
# Get a key at https://aistudio.google.com/apikey - never commit a real
# value here (.env is gitignored; this file is the example/template only).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Fields the extractor resolved with OCR confidence below this are sent to
# Gemini; fields at/above it are left alone.
GEMINI_CONFIDENCE_THRESHOLD=0.75
# Hard cap on ambiguous fields sent per scan, in one batched request.
GEMINI_MAX_FIELDS_PER_SCAN=5
# Per-attempt request timeout; one retry is attempted on failure.
GEMINI_TIMEOUT_SECONDS=9

# Optional Tesseract secondary/fallback OCR. PaddleOCR remains authoritative;
# all Tesseract output is review evidence only and is never fed to compliance.
# Requires the optional pytesseract Python package AND native Tesseract binary.
TESSERACT_ENABLED=false
TESSERACT_MODE=secondary
TESSERACT_BINARY_PATH=
TESSERACT_LANGUAGE=eng
TESSERACT_PSM=6
TESSERACT_TIMEOUT_SECONDS=12
TESSERACT_MAX_PIXELS=24000000
TESSERACT_MAX_DETECTIONS=2000

# Experimental LegalLense PDP detector. The training/evaluator pipeline writes
# actual metrics but never promotes a model. Enable only after independent
# checkpoint review; the approval hash must match the evaluated checkpoint.
LEGAL_LENSE_PDP_ENABLED=false
LEGAL_LENSE_PDP_MODEL_PATH=models/legal_lense_pdp_v1.pt
LEGAL_LENSE_PDP_DATASET_SCHEMA_PATH=training/pdp/v1/dataset.yaml
LEGAL_LENSE_PDP_VALIDATION_REPORT=training/pdp/v1/runs/validation.json
LEGAL_LENSE_PDP_VALIDATED_MODEL_SHA256=
LEGAL_LENSE_PDP_PROMOTION_SHA256=
LEGAL_LENSE_PDP_CONFIDENCE=0.25
LEGAL_LENSE_PDP_MAX_REGIONS=32
LEGAL_LENSE_PDP_MAX_PIXELS=50000000
LEGAL_LENSE_PDP_DEVICE=cpu
# Optional OCR of regions from a hash-verified, explicitly enabled PDP model.
# Results remain review-only and never replace full-image PaddleOCR.
LEGAL_LENSE_PDP_CROP_OCR_ENABLED=false

# RFC 3161 trusted timestamping. Explicitly enable before sending to the
# configured public TSA. Sectigo documents a >=15 second interval between
# requests; the client enforces it process-wide. Verification requires the
# OpenSSL CLI and a trusted CA bundle (certifi is used if no path is supplied).
TSA_ENABLED=false
TSA_URL=https://timestamp.sectigo.com
TSA_TRUSTED_CERT_PATH=
TSA_MIN_REQUEST_INTERVAL_SECONDS=15
TSA_POLICY_OID=
# TSA_ENDPOINT/TSA_CERT_PATH remain accepted as legacy aliases for TSA_URL/
# TSA_TRUSTED_CERT_PATH.
TSA_ENDPOINT=
TSA_USERNAME=
TSA_PASSWORD=
TSA_CERT_PATH=
TSA_OPENSSL_PATH=
TSA_TIMEOUT_SECONDS=10
TSA_MAX_RETRIES=1

# e-Maap's public About page describes state API integration as ongoing but
# publishes no API contract. The application reports API_NOT_DOCUMENTED and
# sends no request until an adapter is implemented from official documentation.
EMAAP_ENDPOINT=
EMAAP_API_KEY=
EMAAP_SIMULATOR_ENABLED=false
EMAAP_TIMEOUT_SECONDS=10
EMAAP_MAX_RETRIES=2

# Optional local GS1 Digital Link Resolver Community Edition. This resolves
# configured Digital Link resources only; it is not a product registry and
# does not verify GTIN ownership or authenticity. Keep disabled by default.
GS1_RESOLVER_ENABLED=false
GS1_RESOLVER_BASE_URL=http://localhost:8080
GS1_RESOLVER_TIMEOUT_SECONDS=2
GS1_RESOLVER_MAX_RETRIES=1
# Optional GTINs explicitly seeded from LegalLense's synthetic dev fixture.
GS1_RESOLVER_SYNTHETIC_GTINS=10012345678902
# Used only by the manual synthetic-fixture seeder; never read by the scan API.
# Keep blank here and set it only in the local process environment when seeding.
GS1_RESOLVER_SESSION_TOKEN=

# Optional public product-data lookup using the official Open Food Facts API.
# This is supporting-only evidence and never determines compliance outcomes.
OPEN_FOOD_FACTS_ENABLED=false
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_TIMEOUT_SECONDS=10
OPEN_FOOD_FACTS_MAX_RETRIES=1
OPEN_FOOD_FACTS_USER_AGENT=LegalLense/1.0 (+https://legal-lense.example)
